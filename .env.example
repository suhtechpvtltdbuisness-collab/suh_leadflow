# Turso (libSQL) — create with: turso db create suh-leadflow
# Optional for prospect search: discovery falls back to uncached live lookups
# when this is unset. Required for leads, territories, settings and reporting.
TURSO_DATABASE_URL="libsql://your-database-your-org.turso.io"
TURSO_AUTH_TOKEN=""

# Local development only. Supplies the signed-in user that the `oai-*` request
# headers used to provide, so the gated routes work on a laptop. Ignored when
# NODE_ENV=production.
LOCAL_DEV_USER_EMAIL=""

# Contact string sent as User-Agent to the public OpenStreetMap services.
# Photon returns 503 and Overpass returns 406 without one, so a default is
# always sent; override it with your own contact URL before heavy use.
DISCOVERY_USER_AGENT=""

# Optional self-hosted replacements for the public providers.
NOMINATIM_URL=""
OVERPASS_URL=""

# Optional integrations. Each route returns 503 until its keys are set.
GOOGLE_PLACES_API_KEY=""
GOOGLE_CUSTOM_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
GOOGLE_ADS_WEBHOOK_KEY=""
